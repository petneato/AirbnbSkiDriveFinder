{
  "manifest_version": 3,
  "name": "Ski Pass Finder",
  "version": "1.1.0",
  "description": "On Airbnb, shows the nearest Ikon, Epic and Indy ski resorts with driving times on every search result and listing.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://router.project-osrm.org/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ski Pass Finder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.airbnb.com/*",
        "https://www.airbnb.ca/*",
        "https://www.airbnb.co.uk/*",
        "https://www.airbnb.com.au/*",
        "https://www.airbnb.co.nz/*",
        "https://www.airbnb.ie/*",
        "https://www.airbnb.fr/*",
        "https://www.airbnb.de/*",
        "https://www.airbnb.at/*",
        "https://www.airbnb.ch/*",
        "https://www.airbnb.it/*",
        "https://www.airbnb.es/*",
        "https://www.airbnb.jp/*",
        "https://www.airbnb.cl/*",
        "https://www.airbnb.se/*",
        "https://www.airbnb.no/*",
        "https://www.airbnb.fi/*"
      ],
      "js": [
        "extract.js",
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.airbnb.com/*",
        "https://www.airbnb.ca/*",
        "https://www.airbnb.co.uk/*",
        "https://www.airbnb.com.au/*",
        "https://www.airbnb.co.nz/*",
        "https://www.airbnb.ie/*",
        "https://www.airbnb.fr/*",
        "https://www.airbnb.de/*",
        "https://www.airbnb.at/*",
        "https://www.airbnb.ch/*",
        "https://www.airbnb.it/*",
        "https://www.airbnb.es/*",
        "https://www.airbnb.jp/*",
        "https://www.airbnb.cl/*",
        "https://www.airbnb.se/*",
        "https://www.airbnb.no/*",
        "https://www.airbnb.fi/*"
      ],
      "js": [
        "resorts.js",
        "core.js",
        "extract.js",
        "content.js",
        "search.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
